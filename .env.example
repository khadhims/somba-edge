SERVER_API_URL=http://localhost:3000
SERVER_WS_URL=http://localhost:3000
EDGE_API_KEY=YOUR_EDGE_DEVICE_API_KEY
GO2RTC_URL=http://go2rtc:1988
# URL publik go2rtc untuk browser (live view) — pakai IP/domain edge + port host yang di-map (1988)
STREAM_PUBLIC_URL=http://YOUR_EDGE_PUBLIC_IP:1988
# Optional: override OpenCV RTSP options (default uses TCP + low latency)
# OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|fflags;nobuffer|flags;low_delay
MODELS_DIR=./models
DB_PATH=./data/db/edge.db
IMAGE_DIR=./data/images
SYNC_INTERVAL=5
BATCH_SIZE=50
RECORDINGS_PATH=./data/recordings

# Model inference
PERSON_MODEL=yolov5s.pt
VIOLATION_MODEL=best.pt
PERSON_CLASS=person
VIOLATION_CLASSES=0,1,2
MIN_CONFIDENCE=0.5
VIOLATION_MIN_CONFIDENCE=0.5
VIOLATION_FRAME_INTERVAL=1

# Alert episode (satu alert per episode pelanggaran)
VIOLATION_EPISODE_START_FRAMES=15
VIOLATION_EPISODE_START_SEC=0.5
VIOLATION_EPISODE_END_SEC=5

# Recording debounce (events)
PERSON_START_FRAMES=25
RECORDING_POST_BUFFER_SEC=90
MIN_RECORDING_DURATION_SEC=180
RECORDING_MAX_SEGMENT_SEC=300

# S3 Configuration
S3_ENDPOINT=YOUR_S3_ENDPOINT
S3_ACCESS_KEY=YOUR_S3_ACCESS_KEY
S3_SECRET_KEY=YOUR_S3_SECRET_KEY
S3_BUCKET=YOUR_S3_BUCKET
S3_REGION=YOUR_S3_REGION
